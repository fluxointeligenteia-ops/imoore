NODE_ENV=production
PORT=3001

# Segurança
JWT_SECRET=troque_por_um_segredo_forte
ALLOW_REGISTRATION=false

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_privada
SUPABASE_BUCKET=imoveis
SUPABASE_LEADS_BUCKET=leads-private

# Produção deve usar Supabase real.
DEMO_MODE=false

# Marca d'agua padrao das fotos (opcional; os valores abaixo sao os padroes)
WATERMARK_WIDTH_RATIO=0.40
WATERMARK_MAX_WIDTH=560
WATERMARK_MIN_WIDTH=140
WATERMARK_OPACITY=0.42
WATERMARK_VERTICAL_CENTER=0.72
WATERMARK_SAFE_MARGIN_RATIO=0.055
